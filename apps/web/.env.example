# Local agent the app pairs with to publish.
VITE_AGENT_URL=http://127.0.0.1:4040
# Comma-separated trustless gateways (raw blocks, IPNS records) and delegated routers, used without an agent.
VITE_GATEWAYS=https://trustless-gateway.link,https://gateway.pinata.cloud,https://dweb.link,https://w3s.link
VITE_ROUTERS=https://delegated-ipfs.dev
# Image URL templates, tried in order; {cid} is replaced with a CIDv1
VITE_MEDIA_GATEWAYS=https://{cid}.ipfs.dweb.link/,https://gateway.pinata.cloud/ipfs/{cid}
# Where the public site lives (share links) and where to download the desktop app.
# VITE_PUBLIC_URL=https://socialkey.example
# VITE_DOWNLOAD_URL=https://github.com/you/socialkey/releases
